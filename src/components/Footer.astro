---
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: 'en' | 'fa';
  currentPath?: string;
  alternateUrl?: string;
}

const { lang = 'en', currentPath = '/', alternateUrl } = Astro.props;

const currentYear = new Date().getFullYear();
const isRtl = lang === 'fa';

const footerNav = lang === 'en' ? [
  { label: 'Work', href: '/projects/' },
  { label: 'Practice', href: '/about/' },
  { label: 'Resume', href: '/resume/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy Policy', href: '/privacy/' },
] : [
  { label: 'پروژه‌ها', href: '/fa/projects/' },
  { label: 'رویکرد و استودیو', href: '/fa/about/' },
  { label: 'رزومه', href: '/fa/resume/' },
  { label: 'تماس', href: '/fa/contact/' },
  { label: 'سیاست حفظ حریم خصوصی', href: '/fa/privacy/' },
];

const tagline = lang === 'en'
  ? 'Editorial architectural portfolio focusing on climate-responsive cultural centers, adaptive reuse, and contextual spatial interventions.'
  : 'پورتفولیوی معماری و طراحی فضا با تمرکز بر مراکز فرهنگی اقلیم‌محور، بازآفرینی سازه‌های صنعتی و مداخلات بسترگرا.';

const directContact = lang === 'en' ? 'Discuss a Project' : 'گفتگو پیرامون پروژه';
---

<footer class="site-footer hairline-border-t">
  <div class="site-container footer-inner">
    <div class="footer-top site-grid">
      <!-- Col 1: Statement -->
      <div class="footer-col-brand">
        <h3 class="footer-heading">{lang === 'en' ? 'Arash Ershadi' : 'آرش ارشادی'}</h3>
        <p class="footer-tagline">{tagline}</p>
        <div class="footer-cta-wrap">
          <a href={lang === 'en' ? '/contact/' : '/fa/contact/'} class="btn-editorial">
            <span>{directContact}</span>
            <span aria-hidden="true">{isRtl ? '←' : '→'}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-col-nav">
        <h4 class="footer-subheading">{lang === 'en' ? 'Navigation' : 'فهرست بخش‌ها'}</h4>
        <ul class="footer-nav-list">
          {footerNav.map((item) => (
            <li>
              <a href={item.href} class="footer-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Details & Language -->
      <div class="footer-col-meta">
        <h4 class="footer-subheading">{lang === 'en' ? 'Edition & Language' : 'ویرایش و زبان'}</h4>
        <div class="footer-lang-wrap">
          <LanguageSwitcher currentLang={lang} currentPath={currentPath} alternateUrl={alternateUrl} />
        </div>
        <p class="footer-meta-note text-muted text-label">
          {lang === 'en' ? 'Curated Monograph Edition 2026' : 'نسخه کتابچه معماری ۲۰۲۶'}
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom hairline-border-t">
      <p class="copyright text-muted text-xs">
        © {currentYear} Arash Ershadi. {lang === 'en' ? 'All rights reserved. Built with Astro & TypeScript.' : 'کلیه حقوق محفوظ است. پیاده‌سازی با استرو و تایپ‌اسکریپت.'}
      </p>
      <div class="footer-legal-links">
        <a href={lang === 'en' ? '/privacy/' : '/fa/privacy/'} class="text-xs text-muted footer-legal-link">
          {lang === 'en' ? 'Privacy' : 'حریم خصوصی'}
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-subtle);
    margin-top: var(--space-24);
    padding-top: var(--space-16);
  }

  .footer-top {
    row-gap: var(--space-8);
    margin-bottom: var(--space-16);
  }

  .footer-col-brand {
    grid-column: span 6;
  }

  .footer-col-nav {
    grid-column: span 3;
  }

  .footer-col-meta {
    grid-column: span 3;
  }

  .footer-heading {
    font-size: var(--text-2xl);
    font-family: var(--font-serif);
    margin-bottom: var(--space-3);
  }

  [dir="rtl"] .footer-heading {
    font-family: var(--font-farsi);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 440px;
    margin-bottom: var(--space-6);
  }

  .footer-subheading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .footer-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-text);
  }

  .footer-lang-wrap {
    margin-bottom: var(--space-3);
  }

  .footer-meta-note {
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-legal-link:hover {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .footer-col-brand { grid-column: span 12; }
    .footer-col-nav { grid-column: span 6; }
    .footer-col-meta { grid-column: span 6; }
  }
</style>
