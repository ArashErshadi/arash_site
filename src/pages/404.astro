---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Drawing Not Located | Arash Ershadi"
  description="The requested architectural drawing or page could not be located."
  lang="en"
  currentPath="/404"
>
  <div class="site-container-narrow not-found-page">
    <span class="text-mono text-xs text-accent">ERROR 404 // MISSING MONOGRAPH PLATE</span>
    <h1 class="not-found-title text-serif">Requested Drawing Not Located</h1>
    <p class="not-found-desc text-muted">
      The spatial document or route you requested has been relocated or archived.
    </p>

    <div class="bilingual-box hairline-border-t hairline-border-b">
      <p class="farsi-notice" dir="rtl" lang="fa">
        صفحه یا نقشه درخواستی شما در این نشانی قرار ندارد. لطفاً از پیوندهای زیر برای بازگشت به آرشیو پروژه‌ها یا صفحه اصلی استفاده نمایید.
      </p>
    </div>

    <div class="not-found-actions">
      <a href="/" class="btn-editorial">
        <span>Return to Homepage (EN)</span>
        <span aria-hidden="true">→</span>
      </a>
      <a href="/fa/" class="btn-editorial-outline">
        <span>صفحه اصلی (فارسی)</span>
      </a>
      <a href="/projects/" class="btn-editorial-outline">
        <span>Explore All Projects</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .not-found-title {
    font-size: clamp(2rem, 4vw, var(--text-4xl));
    margin-top: var(--space-2);
  }

  .not-found-desc {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .bilingual-box {
    margin-block: var(--space-4);
    padding-block: var(--space-4);
  }

  .farsi-notice {
    font-family: var(--font-farsi);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
</style>
