---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Project Inquiries | Arash Ershadi"
  description="Direct contact information for architectural commissions, spatial research inquiries, lectures, and studio collaboration."
  lang="en"
  currentPath="/contact/"
>
  <div class="site-container contact-page-header">
    <span class="text-label">Inquiries // Collaboration</span>
    <h1 class="contact-title">Discuss a Project or Collaboration</h1>
    <p class="contact-lead text-muted">
      Available for select architectural commissions, public realm consultations, and spatial research initiatives.
    </p>
  </div>

  <div class="site-container contact-body site-grid">
    <div class="contact-form-col">
      <!-- Static Form pointing to thank-you -->
      <form action="/thank-you/" method="GET" class="contact-form">
        <div class="form-group">
          <label for="contact-name" class="form-label text-label">Your Name</label>
          <input type="text" id="contact-name" name="name" required placeholder="e.g. Jane Doe" class="form-input" />
        </div>

        <div class="form-group">
          <label for="contact-email" class="form-label text-label">Email Address</label>
          <input type="email" id="contact-email" name="email" required placeholder="jane@example.com" class="form-input" />
        </div>

        <div class="form-group">
          <label for="contact-typology" class="form-label text-label">Project Typology / Nature of Inquiry</label>
          <select id="contact-typology" name="typology" class="form-select">
            <option value="cultural">Cultural / Civic Pavilion</option>
            <option value="adaptive-reuse">Adaptive Reuse / Heritage</option>
            <option value="landscape">Landscape / Public Realm</option>
            <option value="research">Academic / Editorial / Research</option>
            <option value="other">Other Inquiry</option>
          </select>
        </div>

        <div class="form-group">
          <label for="contact-message" class="form-label text-label">Project Overview or Message</label>
          <textarea id="contact-message" name="message" rows="5" required placeholder="Describe site context, project timeline, and core objectives..." class="form-textarea"></textarea>
        </div>

        <button type="submit" class="btn-editorial">
          <span>Submit Inquiry</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>

    <aside class="contact-info-col">
      <div class="contact-info-card">
        <h3 class="side-card-title text-label">Direct Studio Email</h3>
        <p class="text-sm">Prefer direct email? Send drawings or brief outlines directly to:</p>
        <p class="direct-email-link">
          <a href="mailto:arash.ershadi.arch@example.com" class="btn-editorial-outline">
            <span>arash.ershadi.arch@example.com</span>
          </a>
        </p>
      </div>

      <div class="contact-info-card">
        <h3 class="side-card-title text-label">Studio Locations</h3>
        <ul class="text-sm text-muted">
          <li><strong>Studio Tehran:</strong> District 6, Tehran, Iran</li>
          <li><strong>Studio Isfahan:</strong> Abbas Abad St, Isfahan, Iran</li>
        </ul>
      </div>

      <div class="contact-info-card">
        <h3 class="side-card-title text-label">Digital Presence</h3>
        <ul class="text-sm text-muted">
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub // Computational Scripts</a></li>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn // Professional Profile</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .contact-page-header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .contact-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .contact-lead {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    max-width: 720px;
  }

  .contact-body {
    padding-bottom: var(--space-24);
  }

  .contact-form-col {
    grid-column: span 7;
  }

  .contact-info-col {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--color-text);
  }

  .contact-info-card {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .side-card-title {
    border-bottom: 1px solid var(--color-border-hairline);
    padding-bottom: var(--space-2);
  }

  .direct-email-link {
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .contact-form-col { grid-column: span 12; }
    .contact-info-col { grid-column: span 12; }
  }
</style>
