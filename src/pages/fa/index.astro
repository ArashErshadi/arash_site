---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getFeaturedProjects } from '../../utils/projects';

const featuredProjects = await getFeaturedProjects('fa');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'mainEntity': {
    '@type': 'Person',
    'name': 'آرش ارشادی',
    'jobTitle': 'طراح معمار',
    'description': 'طراح معمار با تمرکز بر مراکز فرهنگی اقلیم‌محور، بازآفرینی سازه‌های صنعتی و مداخلات بسترگرا.',
    'url': 'https://mg.github.io/fa/',
    'sameAs': [
      'https://github.com/',
      'https://linkedin.com/'
    ]
  }
};
---

<BaseLayout
  title="آرش ارشادی | طراح معمار"
  description="پورتفولیوی معماری و طراحی فضا با تمرکز بر مراکز فرهنگی اقلیم‌محور، بازآفرینی سازه‌های صنعتی و مداخلات بسترگرا."
  lang="fa"
  currentPath="/fa/"
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="site-container">
      <div class="hero-grid site-grid">
        <div class="hero-content">
          <span class="hero-eyebrow text-label">کتابچه سوابق و آثار معماری // ویرایش ۱۴۰۴</span>
          <h1 class="hero-title">
            ساختارهای فضایی برآمده از اقلیم، خلوص مصالح و حافظه تاریخی بستر.
          </h1>
          <p class="hero-statement text-muted">
            استودیوی مستقل معماری با تمرکز بر سامانه‌های نوین ساخت، تهویه غیرفعال اقلیمی و بازآفرینی میراث صنعتی و بومی فلات ایران.
          </p>
          <div class="hero-actions">
            <a href="/fa/projects/" class="btn-editorial">
              <span>مشاهده پروژه‌های برگزیده</span>
              <span aria-hidden="true">←</span>
            </a>
            <a href="/fa/about/" class="btn-editorial-outline">
              <span>رویکرد و مبانی طراحی</span>
            </a>
          </div>
        </div>

        <div class="hero-meta-panel">
          <div class="hero-meta-block hairline-border-b">
            <span class="text-label">حوزه فعالیت</span>
            <p class="hero-meta-val">طراحی معماری، پژوهش‌های فضایی و سامانه‌های ساخت</p>
          </div>
          <div class="hero-meta-block hairline-border-b">
            <span class="text-label">گونه‌های اصلی</span>
            <p class="hero-meta-val">پاویون‌های فرهنگی، بازآفرینی سازه‌های صنعتی، فضای همگانی</p>
          </div>
          <div class="hero-meta-block">
            <span class="text-label">ارتباط مستقیم</span>
            <p class="hero-meta-val">
              <a href="/fa/contact/" class="text-accent">arash.ershadi.arch@example.com</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider site-container" />

  <!-- Selected Projects Grid -->
  <section class="selected-projects-section">
    <div class="site-container">
      <div class="section-header">
        <div>
          <span class="text-label">۰۱ // پروژه‌های منتخب</span>
          <h2 class="section-title">پروژه‌های برگزیده معماری</h2>
        </div>
        <a href="/fa/projects/" class="section-link text-sm">
          <span>مشاهده همه پروژه‌ها ({featuredProjects.length})</span>
          <span aria-hidden="true">←</span>
        </a>
      </div>

      <div class="projects-grid">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} locale="fa" index={index} />
        ))}
      </div>
    </div>
  </section>

  <hr class="section-divider site-container" />

  <!-- Practice Snapshot -->
  <section class="practice-snapshot-section">
    <div class="site-container">
      <div class="site-grid">
        <div class="practice-col-intro">
          <span class="text-label">۰۲ // رویکرد فضایی</span>
          <h2 class="practice-heading">معماری به عنوان پاسخی سنجیده به جغرافیا و اقلیم.</h2>
        </div>

        <div class="practice-col-details">
          <p class="practice-text">
            رویکرد ما تحمیل فرم‌های انتزاعی به زمین نیست؛ هر طرح با خوانش دقیق بستر آغاز می‌شود: رهگیری زوایای تابش، بادهای غالب، نوسانات دمایی شبانه‌روز و بازخوانی الگوهای ساخت بومی.
          </p>
          <div class="practice-points-grid">
            <div class="practice-point hairline-border-t">
              <span class="text-mono text-xs text-accent">۰۱ / آیرودینامیک غیرفعال</span>
              <p class="text-sm text-muted">بهره‌گیری از اختلاف فشار و بادگیرها جهت حذف وابستگی به سامانه‌های سرمایش مکانیکی.</p>
            </div>
            <div class="practice-point hairline-border-t">
              <span class="text-mono text-xs text-accent">۰۲ / صداقت در متریال</span>
              <p class="text-sm text-muted">نمایش صریح خشت فشرده، اتصالات چوبی و آجرکاری سنتی پایدار شده با ملات‌های آهکی.</p>
            </div>
          </div>
          <div class="practice-cta">
            <a href="/fa/about/" class="btn-editorial-outline">
              <span>مطالعه کامل مانیفست استودیو</span>
              <span aria-hidden="true">←</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
  }

  .hero-grid {
    row-gap: var(--space-8);
  }

  .hero-content {
    grid-column: span 8;
  }

  .hero-meta-panel {
    grid-column: span 4;
    background-color: var(--color-bg-subtle);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .hero-eyebrow {
    display: block;
    margin-bottom: var(--space-3);
  }

  .hero-title {
    margin-bottom: var(--space-6);
    font-weight: 500;
  }

  .hero-statement {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    max-width: 680px;
    margin-bottom: var(--space-8);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-meta-block {
    padding-bottom: var(--space-3);
  }

  .hero-meta-val {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
    margin-top: var(--space-1);
    margin-bottom: 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .section-title {
    font-size: var(--text-3xl);
    margin-top: var(--space-1);
  }

  .section-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .practice-col-intro {
    grid-column: span 5;
  }

  .practice-heading {
    font-size: var(--text-3xl);
    font-weight: 500;
    line-height: var(--leading-snug);
    margin-top: var(--space-2);
  }

  .practice-col-details {
    grid-column: span 7;
  }

  .practice-text {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-body);
    margin-bottom: var(--space-8);
  }

  .practice-points-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .practice-point {
    padding-top: var(--space-4);
  }

  .practice-point span {
    display: block;
    margin-bottom: var(--space-2);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .hero-content { grid-column: span 12; }
    .hero-meta-panel { grid-column: span 12; }
    .projects-grid { grid-template-columns: 1fr; }
    .practice-col-intro { grid-column: span 12; }
    .practice-col-details { grid-column: span 12; }
    .practice-points-grid { grid-template-columns: 1fr; }
  }
</style>
