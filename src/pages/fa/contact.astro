---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="تماس و شروع همکاری | آرش ارشادی"
  description="ارتباط مستقیم جهت سفارش پروژه‌های معماری، مشاوره‌های فضایی، سخنرانی‌های آکادمیک و همکاری استودیویی."
  lang="fa"
  currentPath="/fa/contact/"
>
  <div class="site-container contact-page-header">
    <span class="text-label">ارتباط // همکاری حرفه‌ای</span>
    <h1 class="contact-title">گفتگو پیرامون پروژه و همکاری</h1>
    <p class="contact-lead text-muted">
      آماده پذیرش پروژه‌های برگزیده معماری، بازآفرینی سازه‌های صنعتی و همکاری در پژوهش‌های فضایی.
    </p>
  </div>

  <div class="site-container contact-body site-grid">
    <div class="contact-form-col">
      <!-- Static Form pointing to thank-you -->
      <form action="/fa/thank-you/" method="GET" class="contact-form">
        <div class="form-group">
          <label for="contact-name" class="form-label text-label">نام و نام خانوادگی</label>
          <input type="text" id="contact-name" name="name" required placeholder="مثال: سارا محمدی" class="form-input" />
        </div>

        <div class="form-group">
          <label for="contact-email" class="form-label text-label">نشانی ایمیل</label>
          <input type="email" id="contact-email" name="email" required placeholder="sara@example.com" class="form-input" />
        </div>

        <div class="form-group">
          <label for="contact-typology" class="form-label text-label">گونه‌شناسی پروژه / موضوع پیام</label>
          <select id="contact-typology" name="typology" class="form-select">
            <option value="cultural">پاویون یا مجتمع فرهنگی</option>
            <option value="adaptive-reuse">بازآفرینی سازه کهن / صنعتی</option>
            <option value="landscape">منظر و فضای همگانی</option>
            <option value="research">همکاری آکادمیک / پژوهشی</option>
            <option value="other">سایر موضوعات</option>
          </select>
        </div>

        <div class="form-group">
          <label for="contact-message" class="form-label text-label">شرح پروژه یا پیام</label>
          <textarea id="contact-message" name="message" rows="5" required placeholder="توضیحات بستر، زمان‌بندی و اهداف کلی طرح..." class="form-textarea"></textarea>
        </div>

        <button type="submit" class="btn-editorial">
          <span>ارسال درخواست</span>
          <span aria-hidden="true">←</span>
        </button>
      </form>
    </div>

    <aside class="contact-info-col">
      <div class="contact-info-card">
        <h3 class="side-card-title text-label">مکاتبه مستقیم با ایمیل</h3>
        <p class="text-sm">در صورت تمایل به ارسال مستقیم مدارک و نقشه‌ها، از نشانی زیر استفاده نمایید:</p>
        <p class="direct-email-link">
          <a href="mailto:arash.ershadi.arch@example.com" class="btn-editorial-outline">
            <span>arash.ershadi.arch@example.com</span>
          </a>
        </p>
      </div>

      <div class="contact-info-card">
        <h3 class="side-card-title text-label">استودیوها</h3>
        <ul class="text-sm text-muted">
          <li><strong>استودیو تهران:</strong> منطقه ۶، تهران</li>
          <li><strong>استودیو اصفهان:</strong> خیابان عباس‌آباد، اصفهان</li>
        </ul>
      </div>

      <div class="contact-info-card">
        <h3 class="side-card-title text-label">حضور دیجیتال</h3>
        <ul class="text-sm text-muted">
          <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">گیت‌هاب // اسکریپت‌های محاسباتی</a></li>
          <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">لینکدین // پروفایل حرفه‌ای</a></li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .contact-page-header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .contact-title {
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .contact-lead {
    font-size: var(--text-xl);
    line-height: var(--leading-relaxed);
    max-width: 720px;
  }

  .contact-body {
    padding-bottom: var(--space-24);
  }

  .contact-form-col {
    grid-column: span 7;
  }

  .contact-info-col {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text);
    transition: border-color var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    border-color: var(--color-text);
  }

  .contact-info-card {
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .side-card-title {
    border-bottom: 1px solid var(--color-border-hairline);
    padding-bottom: var(--space-2);
    font-weight: 600;
  }

  .direct-email-link {
    margin-top: var(--space-2);
  }

  @media (max-width: 768px) {
    .contact-form-col { grid-column: span 12; }
    .contact-info-col { grid-column: span 12; }
  }
</style>
